# Copy to .env. Never commit .env.

# mock = simulated data (default). real = official MetaTrader5 package + installed terminal.
TRADELAB_MT5_ADAPTER=mock

# Only for TRADELAB_MT5_ADAPTER=real. All optional: with none set, the connector
# attaches to the terminal that is already running and logged in.
# TRADELAB_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# TRADELAB_MT5_LOGIN=
# TRADELAB_MT5_PASSWORD=
# TRADELAB_MT5_SERVER=

# TRADELAB_DATABASE_URL=sqlite:///storage/tradelab.db
# TRADELAB_API_PORT=8010   (if changed, update the proxy in frontend/vite.config.ts)

# Risk safeguards (bounded; see backend/config/settings.py)
# TRADELAB_RISK_RISK_PER_TRADE_PCT=0.5
# TRADELAB_RISK_MAX_DAILY_LOSS_PCT=2.0
# TRADELAB_RISK_MAX_TOTAL_DRAWDOWN_PCT=5.0
# TRADELAB_RISK_MAX_OPEN_POSITIONS=3
# TRADELAB_RISK_MAX_TRADES_PER_DAY=10
# TRADELAB_RISK_MIN_REWARD_TO_RISK=1.5
# TRADELAB_RISK_MAX_CONCURRENT_PLANNED_RISK_PCT=1.5
